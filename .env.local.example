# --- browser + server (public) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
# Where the app is reachable (used in invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- server only (never shipped to the browser) ---
# When Next runs inside Docker, the browser talks to localhost:54321 but the
# container must reach Supabase on the host — set this to http://host.docker.internal:54321
SUPABASE_INTERNAL_URL=
SUPABASE_SERVICE_ROLE_KEY=replace-me
CRON_SECRET=replace-me-with-a-long-random-string
